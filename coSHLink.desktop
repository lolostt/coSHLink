[Desktop Entry]
# coSHLink: double-click in the file manager to open a terminal window
# running coSHLink.sh --loop (q or Ctrl+C quits). Keep it next to coSHLink.sh.
# The first time, GNOME Files asks to trust it (right click, "Allow
# Launching"); KDE Dolphin asks to make it executable. On an error (a
# missing tool, a window too small) the window stays open until Enter.
Type=Application
Name=coSHLink
Comment=The way from this computer to the internet, live
Terminal=true
Exec=bash -c 'printf "\\033]0;coSHLink\\007\\033[8;24;80t"; sleep 0.5; "$(dirname "$1")/coSHLink.sh" --loop || [ $? = 130 ] || read -r -p "Press Enter to close" _' coSHLink %k
Icon=network-wired
Categories=Network;Monitor;
